{
  "name": "dsh-web-search-plugin",
  "version": "0.3.0",
  "description": "Unified web search for the DeepSeek Harness seam (ctx.web): DeepSeek (official), Tavily, Brave, Serper, SerpApi, Exa, SearXNG, Scavio, and Firecrawl backends",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "tavily",
    "brave",
    "brave-search",
    "web-search",
    "websearch",
    "search",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/shared.js && node --check lib/providers.js && node --check lib/rest.js && node --check lib/tavily.js && node --check lib/brave.js && node --check lib/deepseek.js && node --check lib/usage.js"
  },
  "dependencies": {
    "undici": "^6.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/X-C1811/dsh-web-search-plugin.git"
  },
  "homepage": "https://github.com/X-C1811/dsh-web-search-plugin",
  "bugs": {
    "url": "https://github.com/X-C1811/dsh-web-search-plugin/issues"
  }
}
